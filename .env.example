DATABASE_URL=postgresql://portfolio:local-development-only@127.0.0.1:5432/portfolio
PAYLOAD_SECRET=
SITE_URL=http://localhost:3000
# Explicit opt-in to run the public demo without a CMS connection.
PORTFOLIO_DEMO=false
# Configure all S3 settings in production. Set S3_ENDPOINT for compatible providers.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional Resend notifications. CONTACT_FROM must be verified in Resend.
RESEND_API_KEY=
CONTACT_FROM=
# Set only to a header overwritten by your trusted reverse proxy.
CONTACT_IP_HEADER=
